# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/studentnest?schema=public"

# Random 32+ byte secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me"

# Unsplash API access key (https://unsplash.com/oauth/applications) — only
# used by `npm run fetch:images`, a one-time script that caches landing-page
# photo URLs to src/data/hero-images.json. Not needed at runtime.
UNSPLASH_ACCESS_KEY=

# Paystack (added when payment integration lands)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=

# Maps (added when interactive map / distance lookup lands)
# GOOGLE_MAPS_API_KEY=
